  "records": [
    {
      "id": "ct-visibility",
      "work_id": "work:pmid:33925859",
      "topic": "ct_isoattenuating_visibility",
      "facts": [
        {
          "role": "definition",
          "text": "Some pancreatic cancers have nearly the same density as the surrounding pancreas on contrast-enhanced CT. This weak contrast can make the tumor difficult to see; the term isoattenuating describes that similar appearance.",
          "evidence": [
            "iso-6"
          ]
        },
        {
          "role": "context",
          "text": "The paper describes indirect clues such as a widened or interrupted pancreatic duct, widening of the common bile duct, shrinkage of tissue beyond the tumor, or an abnormal pancreatic contour.",
          "evidence": [
            "iso-7"
          ]
        },
        {
          "role": "scope_limit",
          "text": "The cited study included patients with confirmed pancreatic cancer. It did not compare these tumors with other diagnoses, so its findings do not establish that a similar-looking finding in another patient is cancer.",
          "evidence": [
            "iso-57"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:02ec62abb0b23f7a02c5ba4c59a16d41159ab58a3408731259e26ba3131564d0"
      ]
    },
    {
      "id": "ct-study-limits",
      "work_id": "work:pmid:33925859",
      "topic": "ct_isoattenuating_study_limits",
      "facts": [
        {
          "role": "design",
          "text": "The study of isoattenuating pancreatic carcinomas used retrospective data from one center and a small sample, which the authors identify as possible sources of bias.",
          "evidence": [
            "iso-55"
          ]
        },
        {
          "role": "selection",
          "text": "It included only pancreatic tumors confirmed by endoscopic ultrasound-guided fine-needle aspiration (EUS-FNA). False-positive EUS-FNA cases were excluded, so the study could not determine the test’s specificity.",
          "evidence": [
            "iso-55",
            "iso-56"
          ]
        },
        {
          "role": "reference_limit",
          "text": "Only cytology samples were collected. These could not establish tumor type or grade, or compare the tissue-level density of tumor cells, vessels and fibrous tissue between the tumor groups.",
          "evidence": [
            "iso-56"
          ]
        },
        {
          "role": "scope_limit",
          "text": "Because the study focused on patients with confirmed pancreatic cancer, it could not evaluate how isoattenuating carcinomas differed from other diagnoses.",
          "evidence": [
            "iso-57"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:3abe34581145cb3559f5a921f52f5b4ab98d6df42bb9aec4ff17f273d3dd8937"
      ]
    },
    {
      "id": "ct-reader-variation",
      "work_id": "work:pmid:34381070",
      "topic": "ct_reader_variation",
      "facts": [
        {
          "role": "finding",
          "text": "Yes. In one pancreatic cancer CT study, radiologists drew smaller tumor contours on average than radiation oncologists: reported mean volumes were 35.6 ± 15.0 cm³ and 54.1 ± 15.9 cm³, respectively. The ± terms are reproduced as reported; this passage does not define them.",
          "evidence": [
            "reader-20"
          ]
        },
        {
          "role": "population",
          "text": "The retrospective study included 21 patients. Three radiologists and three radiation oncologists independently outlined the tumors in the full cohort.",
          "evidence": [
            "reader-61",
            "reader-64",
            "reader-65"
          ]
        },
        {
          "role": "reference_method",
          "text": "The researchers combined all six observers’ contours with the STAPLE algorithm to create a consensus volume as a ground-truth surrogate. That is an observer-derived reference, not an independent proof of the true tumor boundary.",
          "evidence": [
            "reader-67"
          ]
        },
        {
          "role": "scope_limit",
          "text": "The study limited CT acquisition settings and fixed the display window and level. The authors caution that their findings may need validation before being generalized to other settings.",
          "evidence": [
            "reader-56",
            "reader-57"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:5669fa705129190625c15c851e6f1c2ebbd5deff2abe1a74f7943cb89b6a17ae"
      ]
    },
    {
      "id": "ct-radiomics-limits",
      "work_id": "work:pmid:34381070",
      "topic": "ct_radiomics_limits",
      "facts": [
        {
          "role": "acquisition",
          "text": "The pancreatic radiomics study restricted scanner types and acquisition parameters, and used a fixed display window and level to isolate differences between observers from imaging and display differences.",
          "evidence": [
            "reader-56",
            "reader-57"
          ]
        },
        {
          "role": "voxel_processing",
          "text": "Before extracting radiomic features, images were resampled to isotropic 5 × 5 × 5 mm voxels using sinc interpolation. The authors warn that these relatively large voxels could introduce edge and partial-volume effects.",
          "evidence": [
            "reader-57",
            "reader-77"
          ]
        },
        {
          "role": "scope_limit",
          "text": "The findings therefore reflect the study’s specific acquisition, reconstruction and display settings. The authors say they may need validation before generalization to other cases.",
          "evidence": [
            "reader-57"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:d041abba78b3190799efd8a6ccdfc5c16154d32742d0f1240c277f5351eef499"
      ]
    },
    {
      "id": "ct-contour-protocol",
      "work_id": "work:pmid:34381070",
      "topic": "ct_contour_protocol",
      "facts": [
        {
          "role": "uncertainty",
          "text": "In the pancreatic CT study, observers were told to outline only tissue they felt certain was gross tumor and to exclude uncertain areas.",
          "evidence": [
            "reader-65"
          ]
        },
        {
          "role": "instructions",
          "text": "The instructions also excluded major vessels, stents, markers and lymph nodes when applicable. Observers worked independently using only the assigned CT, with a fixed window width of 400 and level of 50; they were not to use MRI or other CT data.",
          "evidence": [
            "reader-65"
          ]
        },
        {
          "role": "scope_limit",
          "text": "These were the study’s contouring instructions under fixed acquisition and display conditions. The authors caution that their results may need validation before being generalized to other cases.",
          "evidence": [
            "reader-56",
            "reader-57",
            "reader-65"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:48eb12848fc019af9246851bf407e60f52957dd6a47daf2ce0516130af409e88"
      ]
    }
  ]
