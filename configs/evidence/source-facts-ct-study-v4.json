  "records": [
    {
      "id": "ct-visibility",
      "work_id": "work:pmid:33925859",
      "topic": "ct_isoattenuating_visibility",
      "facts": [
        {
          "role": "definition",
          "text": "Some pancreatic cancers have nearly the same density as the surrounding pancreas on contrast-enhanced CT. This weak contrast can make the tumor difficult to see; the term isoattenuating describes that similar appearance.",
          "evidence": [
            "iso-6"
          ]
        },
        {
          "role": "context",
          "text": "The paper describes indirect clues such as a widened or interrupted pancreatic duct, widening of the common bile duct, shrinkage of tissue beyond the tumor, or an abnormal pancreatic contour.",
          "evidence": [
            "iso-7"
          ]
        },
        {
          "role": "scope_limit",
          "text": "The cited study included patients with confirmed pancreatic cancer. It did not compare these tumors with other diagnoses, so its findings do not establish that a similar-looking finding in another patient is cancer.",
          "evidence": [
            "iso-57"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:02ec62abb0b23f7a02c5ba4c59a16d41159ab58a3408731259e26ba3131564d0"
      ]
    },
    {
      "id": "ct-study-limits",
      "work_id": "work:pmid:33925859",
      "topic": "ct_isoattenuating_study_limits",
      "facts": [
        {
          "role": "design",
          "text": "The study of isoattenuating pancreatic carcinomas used retrospective data from one center and a small sample, which the authors identify as possible sources of bias.",
          "evidence": [
            "iso-55"
          ]
        },
        {
          "role": "selection",
          "text": "It included only pancreatic tumors confirmed by endoscopic ultrasound-guided fine-needle aspiration (EUS-FNA). False-positive EUS-FNA cases were excluded, so the study could not determine the test’s specificity.",
          "evidence": [
            "iso-55",
            "iso-56"
          ]
        },
        {
          "role": "reference_limit",
          "text": "Only cytology samples were collected. These could not establish tumor type or grade, or compare the tissue-level density of tumor cells, vessels and fibrous tissue between the tumor groups.",
          "evidence": [
            "iso-56"
          ]
        },
        {
          "role": "scope_limit",
          "text": "Because the study focused on patients with confirmed pancreatic cancer, it could not evaluate how isoattenuating carcinomas differed from other diagnoses.",
          "evidence": [
            "iso-57"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:3abe34581145cb3559f5a921f52f5b4ab98d6df42bb9aec4ff17f273d3dd8937"
      ]
    },
    {
      "id": "ct-reader-variation",
      "work_id": "work:pmid:34381070",
      "topic": "ct_reader_variation",
      "facts": [
        {
          "role": "finding",
          "text": "Yes. In one pancreatic cancer CT study, radiologists drew smaller tumor contours on average than radiation oncologists: reported mean volumes were 35.6 ± 15.0 cm³ and 54.1 ± 15.9 cm³, respectively. The ± terms are reproduced as reported; this passage does not define them.",
          "evidence": [
            "reader-20"
          ]
        },
        {
          "role": "population",
          "text": "The retrospective study included 21 patients. Three radiologists and three radiation oncologists independently outlined the tumors in the full cohort.",
          "evidence": [
            "reader-61",
            "reader-64",
            "reader-65"
          ]
        },
        {
          "role": "reference_method",
          "text": "The researchers combined all six observers’ contours with the STAPLE algorithm to create a consensus volume as a ground-truth surrogate. That is an observer-derived reference, not an independent proof of the true tumor boundary.",
          "evidence": [
            "reader-67"
          ]
        },
        {
          "role": "scope_limit",
          "text": "The study limited CT acquisition settings and fixed the display window and level. The authors caution that their findings may need validation before being generalized to other settings.",
          "evidence": [
            "reader-56",
            "reader-57"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:5669fa705129190625c15c851e6f1c2ebbd5deff2abe1a74f7943cb89b6a17ae"
      ]
    },
    {
      "id": "ct-radiomics-limits",
      "work_id": "work:pmid:34381070",
      "topic": "ct_radiomics_limits",
      "facts": [
        {
          "role": "acquisition",
          "text": "The pancreatic radiomics study restricted scanner types and acquisition parameters, and used a fixed display window and level to isolate differences between observers from imaging and display differences.",
          "evidence": [
            "reader-56",
            "reader-57"
          ]
        },
        {
          "role": "voxel_processing",
          "text": "Before extracting radiomic features, images were resampled to isotropic 5 × 5 × 5 mm voxels using sinc interpolation. The authors warn that these relatively large voxels could introduce edge and partial-volume effects.",
          "evidence": [
            "reader-57",
            "reader-77"
          ]
        },
        {
          "role": "scope_limit",
          "text": "The findings therefore reflect the study’s specific acquisition, reconstruction and display settings. The authors say they may need validation before generalization to other cases.",
          "evidence": [
            "reader-57"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:d041abba78b3190799efd8a6ccdfc5c16154d32742d0f1240c277f5351eef499"
      ]
    },
    {
      "id": "ct-contour-protocol",
      "work_id": "work:pmid:34381070",
      "topic": "ct_contour_protocol",
      "facts": [
        {
          "role": "uncertainty",
          "text": "In the pancreatic CT study, observers were told to outline only tissue they felt certain was gross tumor and to exclude uncertain areas.",
          "evidence": [
            "reader-65"
          ]
        },
        {
          "role": "instructions",
          "text": "The instructions also excluded major vessels, stents, markers and lymph nodes when applicable. Observers worked independently using only the assigned CT, with a fixed window width of 400 and level of 50; they were not to use MRI or other CT data.",
          "evidence": [
            "reader-65"
          ]
        },
        {
          "role": "scope_limit",
          "text": "These were the study’s contouring instructions under fixed acquisition and display conditions. The authors caution that their results may need validation before being generalized to other cases.",
          "evidence": [
            "reader-56",
            "reader-57",
            "reader-65"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:48eb12848fc019af9246851bf407e60f52957dd6a47daf2ce0516130af409e88"
      ]
    },
    {
      "id": "tags-reader-reliability",
      "work_id": "work:pmid:42738357",
      "topic": "tags_reader_reliability",
      "facts": [
        {
          "role": "inter_reader",
          "text": "In the multicenter TAGS study, two radiologists independently outlined tumors on 30 randomly selected CT examinations that neither had previously segmented. Mean agreement between readers was Dice 0.742.",
          "evidence": [
            "work:pmid:42738357-20",
            "work:pmid:42738357-21"
          ]
        },
        {
          "role": "repeat_reader",
          "text": "One radiologist then repeated tumor segmentation on 30 randomly selected CT examinations after a three-week washout. Mean repeat-reader Dice was 0.838.",
          "evidence": [
            "work:pmid:42738357-21",
            "work:pmid:42738357-22"
          ]
        },
        {
          "role": "scope_limit",
          "text": "Agreement was assessed using Dice, 95th-percentile Hausdorff distance and normalized surface Dice at 5 mm. The 30 inter-reader cases belonged to the 500-case cohort; their additional reliability contours were not reference labels for model evaluation.",
          "evidence": [
            "work:pmid:42738357-20",
            "work:pmid:42738357-21"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:b93e0689b2458b99d3e8ab56ab56b706dda295bde368cc5982f628d0d29ad2f1"
      ]
    },
    {
      "id": "tags-reference-masks",
      "work_id": "work:pmid:42738357",
      "topic": "tags_reference_masks",
      "facts": [
        {
          "role": "creation",
          "text": "For the multicenter TAGS dataset, one of two abdominal radiologists manually outlined the pancreas and tumor in 3D Slicer. Each had more than five years of abdominal radiology experience, and each CT was initially labeled by one reader rather than by consensus.",
          "evidence": [
            "work:pmid:42738357-18"
          ]
        },
        {
          "role": "review",
          "text": "Senior abdominal radiologists with at least 15 years of experience reviewed every segmentation and directly edited masks needing correction.",
          "evidence": [
            "work:pmid:42738357-19"
          ]
        },
        {
          "role": "scope_limit",
          "text": "The separate inter-reader reliability exercise used 30 cases from the 500-case cohort. Its second set of contours was used only for reliability assessment and did not replace the reference labels.",
          "evidence": [
            "work:pmid:42738357-20",
            "work:pmid:42738357-21"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:7efdacb2237292cfe126a4f68121a12fcf73aa924dd9af46279c712856c30216"
      ]
    },
    {
      "id": "tags-comparison-limits",
      "work_id": "work:pmid:42738357",
      "topic": "tags_comparison_limits",
      "facts": [
        {
          "role": "prompting",
          "text": "The multicenter TAGS comparison supplied tumor-location information: most methods received a foreground point sampled from the reference tumor mask, while MedSAM2 used a bounding-box prompt. It therefore did not test fully automatic tumor discovery.",
          "evidence": [
            "work:pmid:42738357-38",
            "work:pmid:42738357-39"
          ]
        },
        {
          "role": "systems",
          "text": "The methods used different native inference pipelines. TAGS also used a TotalSegmentator pancreas mask and text embeddings, so the authors describe a comparison of complete systems rather than matched prompting conditions.",
          "evidence": [
            "work:pmid:42738357-38",
            "work:pmid:42738357-39"
          ]
        },
        {
          "role": "scope_limit",
          "text": "SAM-TAGS and MSD-TAGS did share identical prompts and differed only in initialization. That narrower comparison isolates initialization; it does not make the full comparison a matched, autonomous detection benchmark.",
          "evidence": [
            "work:pmid:42738357-38",
            "work:pmid:42738357-39"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:9f58ae3b663a9aec82887da861c101ae1c72cc8d997f7fdc4e33c05a5cc37b58"
      ]
    },
    {
      "id": "tags-center-transfer",
      "work_id": "work:pmid:42738357",
      "topic": "tags_center_transfer",
      "facts": [
        {
          "role": "design",
          "text": "The multicenter TAGS study tested transfer with leave-one-center-out evaluation: train on three institutions and evaluate on the fourth, repeating this for each of four centers. This was separate from pooled patient-level five-fold cross-validation.",
          "evidence": [
            "work:pmid:42738357-35",
            "work:pmid:42738357-36"
          ]
        },
        {
          "role": "finding",
          "text": "MSD-TAGS mean Dice decreased from 0.703 in pooled evaluation to 0.678 in leave-one-center-out evaluation, an absolute drop of 0.025.",
          "evidence": [
            "work:pmid:42738357-55"
          ]
        },
        {
          "role": "scope_limit",
          "text": "This measures transfer within the study’s four-center evaluation. The inference pipeline still used a point from the reference tumor mask, so these results concern prompted segmentation rather than automatic tumor detection.",
          "evidence": [
            "work:pmid:42738357-36",
            "work:pmid:42738357-38",
            "work:pmid:42738357-39"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:50b39e8335d9b738a038e8bd258cef69880996cbab552c79cb409e2eb5f4bea5"
      ]
    },
    {
      "id": "tags-workflow-limits",
      "work_id": "work:pmid:42738357",
      "topic": "tags_workflow_limits",
      "facts": [
        {
          "role": "finding",
          "text": "Better tumor outlines do not by themselves demonstrate that doctors save time. In the pancreatic TAGS study, the proportion of cases with Dice below 0.50 was 47.0% for zero-shot TAGS versus 15.8% for each fine-tuned variant, SAM-TAGS and MSD-TAGS.",
          "evidence": [
            "work:pmid:42738357-50",
            "work:pmid:42738357-77"
          ]
        },
        {
          "role": "unmeasured",
          "text": "The researchers did not assess interaction time, re-prompting frequency or radiologist workload, and they evaluated no downstream clinical endpoint.",
          "evidence": [
            "work:pmid:42738357-77"
          ]
        },
        {
          "role": "scope_limit",
          "text": "The paper therefore cannot quantify clinical workflow benefit from those segmentation scores. The authors note that low-Dice cases are especially likely to need substantial manual correction.",
          "evidence": [
            "work:pmid:42738357-77"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:cef2c1713eecb1ca99dc971d533ac3aa0f398b53d2d117abf20c6fbbbddf3e77"
      ]
    },
    {
      "id": "subregion-limitations",
      "work_id": "work:pmid:35877639",
      "topic": "subregion_limitations",
      "facts": [
        {
          "role": "assumption",
          "text": "The pancreatic subregion model assumes that the whole pancreas is present and uses the relative length, volume and arrangement of its parts. Surgery such as pancreatectomy or a Whipple procedure can alter that anatomy, while inflammation can change subregion sizes.",
          "evidence": [
            "work:pmid:35877639-28",
            "work:pmid:35877639-59"
          ]
        },
        {
          "role": "scope_limit",
          "text": "The authors caution that the model may be led astray in these settings; they do not establish reliable performance for postoperative or inflamed pancreases. They identify broader training with conditions such as pancreatitis as future work.",
          "evidence": [
            "work:pmid:35877639-59",
            "work:pmid:35877639-60"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:ce12eb10f1f8dddb0f750d432c8122b91cab2e2dd12655d2fad010fb40442001"
      ]
    },
    {
      "id": "subregion-localization",
      "work_id": "work:pmid:35877639",
      "topic": "subregion_localization",
      "facts": [
        {
          "role": "task",
          "text": "No. The pancreatic CT subregion study used reference pancreas outlines to crop the images and set all remaining non-pancreas pixels to zero. Its head, body and tail labeling therefore started with the pancreas already identified.",
          "evidence": [
            "work:pmid:35877639-39",
            "work:pmid:35877639-59"
          ]
        },
        {
          "role": "scope_limit",
          "text": "The authors explicitly left whole-pancreas segmentation outside the paper’s scope. The model also assumed that the whole pancreas was present, with cautions for surgery and inflammation.",
          "evidence": [
            "work:pmid:35877639-59"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:1bd6b8450d59661933e9910c05d53f9e0b3b7e38e8e906ce0a9162d28af4a48c"
      ]
    },
    {
      "id": "subregion-label-consensus",
      "work_id": "work:pmid:35877639",
      "topic": "subregion_label_consensus",
      "facts": [
        {
          "role": "independent_labels",
          "text": "Two radiologists with over 12 years of experience independently labeled pancreatic subregions inside the outlined pancreas across all three study datasets. Their initial labels overlapped by approximately 84%.",
          "evidence": [
            "work:pmid:35877639-23"
          ]
        },
        {
          "role": "reconciliation",
          "text": "The radiologists then shared, reviewed and updated their labels, reaching 96% overall consistency. They settled the remaining 4% by mutual agreement.",
          "evidence": [
            "work:pmid:35877639-24"
          ]
        },
        {
          "role": "scope_limit",
          "text": "These percentages describe agreement during reference-label construction. They are not the AI model’s segmentation accuracy.",
          "evidence": [
            "work:pmid:35877639-23",
            "work:pmid:35877639-24"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:ce9cecad171dc5632f56356621b9a7a2e075b2dbaa6679a14dd34ee160567619"
      ]
    },
    {
      "id": "pancreas-head-anatomy",
      "work_id": "work:pmid:35877639",
      "topic": "pancreas_head_anatomy",
      "facts": [
        {
          "role": "location",
          "text": "The duodenum curves around the head of the pancreas. The anatomy description in the pancreatic subregion paper places the expanded head within that curve.",
          "evidence": [
            "work:pmid:35877639-26"
          ]
        },
        {
          "role": "scope_limit",
          "text": "This is a general anatomical relationship; the same description distinguishes the head from the body and tapered tail.",
          "evidence": [
            "work:pmid:35877639-26"
          ]
        }
      ],
      "retrieval_anchors": [
