    {
      "id": "reviewer-agreement-accuracy",
      "work_id": "work:pmid:41414851",
      "topic": "reviewer_agreement_accuracy",
      "facts": [
        {
          "role": "setting",
          "text": "Yes—greater agreement between reviewers can coexist with poorer agreement with a reference. One example comes from prostate radiotherapy, where two oncologists compared manual contours with reviewed and adjusted AI contours against a consensus reference.",
          "evidence": [
            "work:pmid:41414851-0",
            "work:pmid:41414851-1",
            "work:pmid:41414851-2"
          ]
        },
        {
          "role": "finding",
          "text": "For the clinical target volume, mean agreement between observers rose from Dice 0.78 for manual contours to 0.89 for adjusted AI contours. Yet adjusted AI contours remained less accurate than manual outlines against the reference for the clinical target volume and rectum.",
          "evidence": [
            "work:pmid:41414851-2",
            "work:pmid:41414851-70"
          ]
        },
        {
          "role": "scope_limit",
          "text": "This was a prostate study at one institution with two oncologists and one AI tool. Its findings do not establish pancreatic contour accuracy or prove that agreement between readers equals correctness.",
          "evidence": [
            "work:pmid:41414851-0",
            "work:pmid:41414851-1",
            "work:pmid:41414851-2",
            "work:pmid:41414851-5"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:6352ffddbbfdc92ea88aaa452a9664a97111d3d09d8db4e72e4b8b5e6b101306"
      ]
    },
    {
      "id": "reviewer-acceptance",
      "work_id": "work:pmid:41414851",
      "topic": "reviewer_acceptance",
      "facts": [
        {
          "role": "setting",
          "text": "In the prostate radiotherapy study, adjusted AI contours did not consistently outperform manual outlines for the clinical target volume and rectum. The authors discuss why reviewers might still retain or only lightly edit AI contours.",
          "evidence": [
            "work:pmid:41414851-109",
            "work:pmid:41414851-110"
          ]
        },
        {
          "role": "interpretations",
          "text": "One possible explanation is automation bias—over-reliance on the AI output. Another is deliberate clinical judgment: reviewers may consider a contour good enough and balance minor geometric differences against workflow efficiency.",
          "evidence": [
            "work:pmid:41414851-71",
            "work:pmid:41414851-72",
            "work:pmid:41414851-73",
            "work:pmid:41414851-110",
            "work:pmid:41414851-111"
          ]
        },
        {
          "role": "scope_limit",
          "text": "Those explanations were not proven causes. Contouring times were not recorded, so the study could not directly evaluate the accuracy–efficiency trade-off; decision tracking or interviews were proposed to distinguish unconscious bias from deliberate judgment.",
          "evidence": [
            "work:pmid:41414851-75",
            "work:pmid:41414851-107",
            "work:pmid:41414851-108"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:1005cfb5c5ea9b3fda951ad5edf8ce8bcbc038b57172cf76b3d99663146889de"
      ]
    }
