  "records": [
    {
      "id": "ct-tumor-dimensions",
      "work_id": "work:pmid:33027288",
      "topic": "ct_tumor_diameter_versus_segmented_volume",
      "facts": [
        {
          "role": "definition",
          "text": "Diameter describes a length, while volume describes the segmented tumor in three dimensions. In a CT study of pancreatic cancer, these were measured separately.",
          "evidence": [
            "ct-method-17",
            "ct-method-38"
          ]
        },
        {
          "role": "method",
          "text": "In that study, a radiologist refined a semi-automated tumor outline slice by slice and measured maximum diameters in the axial, coronal and sagittal planes. Software then measured volume from the completed three-dimensional reconstruction.",
          "evidence": [
            "ct-method-16",
            "ct-method-17"
          ]
        },
        {
          "role": "rationale",
          "text": "The authors suggest that volume may better represent the full extent of an irregular lesion. That is their rationale for volumetric analysis, not a guarantee that volume is always the better measurement.",
          "evidence": [
            "ct-method-38"
          ]
        },
        {
          "role": "study_limit",
          "text": "The study was retrospective, came from one institution and included Korean patients with pancreatic cancer undergoing upfront surgery. Its findings cannot be applied directly to patients receiving treatment before surgery.",
          "evidence": [
            "ct-method-46"
          ]
        }
      ],
      "retrieval_anchors": [
        "psg:d4cc9071d4bc1ef101ec32448a41cee63893806fd3f7ff4f669fb3b0fd11df49"
      ]
    }
