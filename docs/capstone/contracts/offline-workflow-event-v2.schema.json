{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prowl.local/contracts/offline-workflow-event-v2.schema.json",
  "title": "Persisted offline workflow stage event v2",
  "description": "Bounded CPU stage events, not the complete Plan04 lifecycle vocabulary. Hash chain, request binding and transitions require executor inspection.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "offline-workflow-event-v2"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "attempt": {
      "const": 1,
      "type": "integer"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "\\+00:00$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previous": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "running",
        "completed",
        "reused",
        "failed"
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "derivation",
        "receipt_sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "derivation": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "error": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "schema",
    "event_id",
    "run_id",
    "attempt",
    "observed_at",
    "sequence",
    "previous",
    "request_sha256",
    "content_sha256",
    "stage",
    "state"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "completed",
              "reused"
            ]
          }
        }
      },
      "then": {
        "required": [
          "reference"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "else": {
        "not": {
          "required": [
            "reference"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ]
}
