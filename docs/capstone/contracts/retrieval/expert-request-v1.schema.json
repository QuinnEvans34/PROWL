{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prowl.local/schemas/retrieval/expert-request-v1",
  "title": "expert-request-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "question"
  ],
  "properties": {
    "schema_version": {
      "const": "prowl-expert-request-v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
