{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prowl.local/schemas/retrieval/expert-route-v1",
  "title": "expert-route-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "request_id",
    "request_sha256",
    "question_original",
    "question_normalized",
    "route",
    "status",
    "reason_codes",
    "required_capabilities",
    "execution",
    "answer",
    "citations",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "prowl-expert-route-v1"
    },
    "policy_version": {
      "const": "scan-question-routing-v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "question_original": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "question_normalized": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "route": {
      "enum": [
        "literature",
        "measurement",
        "reference_comparison",
        "clarification",
        "refusal"
      ]
    },
    "status": {
      "enum": [
        "unavailable",
        "needs_clarification",
        "needs_scope_review",
        "refused"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "enum": [
          "scope_or_privacy_refusal",
          "ambiguous_or_negated_request",
          "unrecognized_task",
          "multiple_tasks",
          "measurement_adapter_unavailable",
          "comparison_adapter_unavailable",
          "verified_findings_required",
          "literature_candidate_only"
        ]
      }
    },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "validated_measurement",
          "validated_location",
          "qualified_subregion",
          "eligible_reference",
          "verified_findings",
          "qualified_literature_retrieval"
        ]
      }
    },
    "execution": {
      "const": "not_started"
    },
    "answer": {
      "type": "null"
    },
    "citations": {
      "type": "array",
      "maxItems": 0
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
