{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prowl.local/schemas/retrieval/metric-result/1.0.0",
  "title": "Plan 07 ranked-metric report (official D-085 plus labelled proposal)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "configuration_id",
    "corpus_id",
    "label_version",
    "official",
    "provisional"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "configuration_id": {
      "type": "string",
      "pattern": "^cfg:[a-z0-9][a-z0-9._-]{0,62}$"
    },
    "corpus_id": {
      "type": "string",
      "pattern": "^corpus:[0-9a-f]{64}$"
    },
    "label_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,62}$"
    },
    "official": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "n_answerable",
        "n_refusal_excluded",
        "undefined_reason",
        "source",
        "passage"
      ],
      "properties": {
        "status": {
          "const": "official_D-085"
        },
        "n_answerable": {
          "type": "integer",
          "minimum": 0
        },
        "n_refusal_excluded": {
          "type": "integer",
          "minimum": 0
        },
        "undefined_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "const": "no_answerable_questions"
            }
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recall_at",
            "mrr"
          ],
          "properties": {
            "recall_at": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "1",
                "3",
                "5",
                "10"
              ],
              "properties": {
                "1": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  ]
                },
                "3": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  ]
                },
                "5": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  ]
                },
                "10": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  ]
                }
              }
            },
            "mrr": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            }
          }
        },
        "passage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recall_at",
            "mrr",
            "comparability",
            "n_undefined"
          ],
          "properties": {
            "recall_at": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "1",
                "3",
                "5",
                "10"
              ],
              "properties": {
                "1": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  ]
                },
                "3": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  ]
                },
                "5": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  ]
                },
                "10": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  ]
                }
              }
            },
            "mrr": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            },
            "comparability": {
              "const": "within_configuration_only"
            },
            "n_undefined": {
              "type": "integer",
              "minimum": 0,
              "description": "Answerable questions with no passage in this configuration fully containing a direct span; excluded from passage means."
            }
          }
        }
      }
    },
    "provisional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "span_hit_recall_at",
        "n_direct_spans"
      ],
      "properties": {
        "status": {
          "const": "proposed_provisional_not_official"
        },
        "span_hit_recall_at": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "1",
            "3",
            "5",
            "10"
          ],
          "properties": {
            "1": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            },
            "3": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            },
            "5": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            },
            "10": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            }
          }
        },
        "n_direct_spans": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
