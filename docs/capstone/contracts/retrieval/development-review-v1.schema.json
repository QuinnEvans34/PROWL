{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "development_content_sha256",
    "answers_sha256",
    "events",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "prowl-development-review-v1"
    },
    "development_content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "answers_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "events": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "reviewer",
          "reviewed_at",
          "stage",
          "decision",
          "human_statement",
          "targets"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "reviewer": {
            "const": "Quinton Evans"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "stage": {
            "enum": [
              "wording_and_answer",
              "evidence_labels",
              "second_consistency"
            ]
          },
          "decision": {
            "enum": [
              "accept",
              "revise",
              "unsure"
            ]
          },
          "human_statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "content_sha256"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^q:dev2-[0-9]{2}$"
                },
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
