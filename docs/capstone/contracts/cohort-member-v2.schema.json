{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prowl.local/schemas/cohort-member-v2/2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "subject_id",
    "protected_role",
    "protection_group_id",
    "target",
    "annotation",
    "qualification"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "protected_role": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "protection_group_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "target": {
      "enum": [
        null,
        "pancreas"
      ]
    },
    "annotation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "qualification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
