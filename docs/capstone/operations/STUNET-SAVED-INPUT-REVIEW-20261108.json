      {
        "line": 19,
        "text": "        num_classes=label_manager.num_segmentation_heads"
      },
      {
        "line": 20,
        "text": "        kernel_sizes = [[3,3,3]] * 6"
      },
      {
        "line": 21,
        "text": "        strides=configuration_manager.pool_op_kernel_sizes[1:]"
      },
      {
        "line": 22,
        "text": "        if len(strides)>5:"
      },
      {
        "line": 23,
        "text": "            strides = strides[:5]"
      },
      {
        "line": 24,
        "text": "        while len(strides)<5:"
