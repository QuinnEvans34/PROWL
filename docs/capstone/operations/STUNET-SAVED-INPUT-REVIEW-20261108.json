        "line": 5,
        "text": "class STUNetTrainer(nnUNetTrainer):"
      },
      {
        "line": 6,
        "text": "    def __init__(self, plans: dict, configuration: str, fold: int, dataset_json: dict, unpack_dataset: bool = True,"
      },
      {
        "line": 7,
        "text": "                 device: torch.device = torch.device('cuda')):"
      },
      {
        "line": 8,
        "text": "        super().__init__(plans, configuration, fold, dataset_json, unpack_dataset, device)"
      },
      {
        "line": 9,
        "text": "        self.num_epochs = 1000"
      },
      {
        "line": 10,
        "text": "        self.initial_lr = 1e-2"
      },
      {
        "line": 11,
        "text": ""
      },
      {
        "line": 12,
        "text": "    @staticmethod"
      },
      {
        "line": 13,
        "text": "    def build_network_architecture(plans_manager,"
      },
      {
        "line": 14,
        "text": "                                   dataset_json,"
      },
      {
        "line": 15,
        "text": "                                   configuration_manager,"
      },
      {
        "line": 16,
        "text": "                                   num_input_channels,"
      },
      {
        "line": 17,
        "text": "                                   enable_deep_supervision: bool = True) -> nn.Module: "
      },
      {
        "line": 18,
        "text": "        label_manager = plans_manager.get_label_manager(dataset_json)"
